GO_PARANOID

root = sqrt(81)
length = sqrt((3 m)^2)
diagonal = hypot(3 m, 4 m)
smallest = min(3 kg, 1 kg, 2 kg)
largest = max(3 kg, 1 kg, 2 kg)

growth = exp(1)
natural = ln(growth)
decades = log10(1000)
right_angle_sine = sinr(pi / 2)
thirty_degree_sine = sind(30)
direction_radians = atan2r(1 m, 1 m)
direction_degrees = atan2d(1 m, 1 m)

print("sqrt(81) = {root}")
print("length = {length}; diagonal = {diagonal}")
print("mass range = {smallest} to {largest}")
print("ln(exp(1)) = {natural}; log10(1000) = {decades}")
print("sinr(pi/2) = {right_angle_sine}; sind(30) = {thirty_degree_sine}")
print("direction = {direction_radians} radians = {direction_degrees} degrees")

seal root
seal length
seal diagonal
seal thirty_degree_sine
seal direction_radians
seal direction_degrees
