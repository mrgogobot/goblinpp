GO_PARANOID

root = sqrt(81)
length = sqrt((3 m)^2)
diagonal = hypot(3 m, 4 m)
smallest = min(3 kg, 1 kg, 2 kg)
largest = max(3 kg, 1 kg, 2 kg)

growth = exp(1)
natural = ln(growth)
decades = log10(1000)
right_angle_sine = sin(pi / 2)
direction = atan2(1 m, 1 m)

print("sqrt(81) = {root}")
print("length = {length}; diagonal = {diagonal}")
print("mass range = {smallest} to {largest}")
print("ln(exp(1)) = {natural}; log10(1000) = {decades}")
print("sin(pi/2) = {right_angle_sine}; direction = {direction} radians")

seal root
seal length
seal diagonal
seal direction
