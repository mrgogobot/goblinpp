{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Goblin++",
  "scopeName": "source.goblinpp",
  "patterns": [
    {"include": "#inlineRust"},
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#directives"},
    {"include": "#statements"},
    {"include": "#booleans"},
    {"include": "#functions"},
    {"include": "#constants"},
    {"include": "#quantities"},
    {"include": "#numbers"},
    {"include": "#assignment-targets"},
    {"include": "#operators"},
    {"include": "#identifiers"}
  ],
  "repository": {
    "inlineRust": {
      "patterns": [
        {
          "name": "meta.embedded.block.rust.goblinpp",
          "begin": "^\\s*(RUST_INLINE_BEGIN)\\s*$",
          "beginCaptures": {"1": {"name": "keyword.control.directive.goblinpp"}},
          "end": "^\\s*(RUST_INLINE_END)\\s*$",
          "endCaptures": {"1": {"name": "keyword.control.directive.goblinpp"}},
          "contentName": "source.rust",
          "patterns": [{"include": "source.rust"}]
        }
      ]
    },
    "comments": {
      "patterns": [
        {"name": "comment.line.number-sign.goblinpp", "match": "#.*$"}
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.goblinpp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {"name": "constant.character.escape.goblinpp", "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9A-Fa-f]{4})"},
            {"name": "variable.other.interpolation.goblinpp", "match": "\\{[A-Za-z_][A-Za-z0-9_]*(?::[^}]*)?\\}"}
          ]
        }
      ]
    },
    "directives": {
      "patterns": [
        {"name": "keyword.control.directive.goblinpp", "match": "\\bGO_PARANOID\\b"}
      ]
    },
    "statements": {
      "patterns": [
        {"name": "keyword.control.loop.goblinpp", "match": "\\b(?:for|in|while|range|break|continue)\\b"},
        {"name": "keyword.control.conditional.goblinpp", "match": "\\b(?:if|else|switch|case|default)\\b"},
        {"name": "keyword.control.function.goblinpp", "match": "\\b(?:g_func|return)\\b"},
        {"name": "keyword.other.statement.goblinpp", "match": "\\bseal\\b"}
      ]
    },
    "booleans": {
      "patterns": [
        {"name": "constant.language.boolean.goblinpp", "match": "\\b(?:true|false)\\b"},
        {"name": "constant.language.arguments.goblinpp", "match": "\\bargc\\b"}
      ]
    },
    "functions": {
      "patterns": [
        {"name": "support.function.builtin.goblinpp", "match": "\\b(?:sum|mean|input|argv|len|append|to_text|parse_number|parse_integer|str_trim|str_contains|str_replace|str_split|str_join|print|printf|abs|sqrt|min|max|floor|ceil|round|exp|ln|log10|sin|cos|tan|asin|acos|atan|atan2|sind|cosd|tand|sinr|cosr|tanr|asind|acosd|atand|asinr|acosr|atanr|atan2d|atan2r|deg2rad|rad2deg|hypot|au2m|m2au|pc2m|m2pc|ly2m|m2ly|magnitude|dot|cross|polar2cartesiand|polar2cartesianr|cartesian_radius|cartesian_azimuthd|cartesian_azimuthr|cartesian_inclinationd|cartesian_inclinationr|spherical2cartesiand|spherical2cartesianr|velocity|velocity_add_galilean|velocity_add_relativistic_collinear|angular_velocityd|angular_velocityr|tangential_velocity|centripetal_acceleration|angular_momentum|angular_momentum_from_velocity|ee_voltage|ee_current|ee_resistance|ee_power|ee_power_i2r|ee_power_v2r|ee_energy|ee_charge|ee_series_resistance|ee_parallel_resistance|ee_rc_time_constant|ee_capacitor_energy|ee_inductor_energy|ee_kcl_residual|ee_kvl_residual|ee_kcl_balanced|ee_kvl_balanced|ee_in_unit|chem_registry_version|chem_atomic_number|chem_atomic_weight|chem_molar_mass|chem_moles|chem_mass|chem_concentration|chem_dilution|fits_hdu_count|fits_header|fits_axis|fits_count|fits_pixel|fits_mean|fits_rows|fits_columns|fits_column|fits_column_valid_count|fits_column_mean|fits_column_min|fits_column_max|fits_select_stats|write_text|write_csv|write_tsv|write_json|plot_fits_histogram|plot_fits_scatter)(?=\\s*\\()"}
      ]
    },
    "constants": {
      "patterns": [
        {"name": "constant.language.scientific.goblinpp", "match": "(?<![A-Za-z0-9_πħωΩΔΣλμσθ∇∂µÅ])(?:speed_of_light|planck_constant|gravitational_constant|boltzmann_constant|avogadro_constant|molar_gas_constant|atomic_mass_constant|hbar|pi|k_B|N_A|m_u|R|c|h|G|π|ħ)(?![A-Za-z0-9_πħωΩΔΣλμσθ∇∂µÅ])"}
      ]
    },
    "quantities": {
      "patterns": [
        {
          "match": "((?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?)([ \\t]+)(kohm|Mohm|ohm|kHz|MHz|mA|uA|µA|mV|kV|kΩ|MΩ|mF|uF|µF|nF|pF|mH|uH|µH|mW|kW|mS|uS|µS|Hz|A|C|V|Ω|F|H|W|S|angstrom|mol|kPa|atm|bar|mL|uL|µL|nm|pm|Pa|Da|kg|km|Å|g|m|s|K|J|L)(?![A-Za-z0-9_πħωΩΔΣλμσθ∇∂µÅ])",
          "captures": {
            "1": {"name": "constant.numeric.goblinpp"},
            "3": {"name": "support.type.unit.goblinpp"}
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {"name": "constant.numeric.goblinpp", "match": "(?<![A-Za-z0-9_])(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?"}
      ]
    },
    "assignment-targets": {
      "patterns": [
        {"name": "variable.other.assignment.goblinpp", "match": "(?<![A-Za-z0-9_πħωΩΔΣλμσθ∇∂µÅ])[A-Za-z_πħωΩΔΣλμσθ∇∂µÅ][A-Za-z0-9_πħωΩΔΣλμσθ∇∂µÅ]*(?=\\s*=(?!=))"}
      ]
    },
    "operators": {
      "patterns": [
        {"name": "keyword.operator.comparison.goblinpp", "match": "<=|>=|!=|==|<|>|≤|≥|≠"},
        {"name": "keyword.operator.logical.goblinpp", "match": "\\b(?:and|or|not)\\b"},
        {"name": "keyword.operator.arithmetic.goblinpp", "match": "[+\\-*/%^²³]"},
        {"name": "keyword.operator.assignment.goblinpp", "match": "="},
        {"name": "punctuation.section.parens.goblinpp", "match": "[()]"},
        {"name": "punctuation.section.array.goblinpp", "match": "[\\[\\]]"},
        {"name": "punctuation.separator.slice.goblinpp", "match": ":"},
        {"name": "punctuation.section.block.goblinpp", "match": "[{}]"},
        {"name": "punctuation.separator.comma.goblinpp", "match": ","}
      ]
    },
    "identifiers": {
      "patterns": [
        {"name": "variable.other.goblinpp", "match": "[A-Za-z_πħωΩΔΣλμσθ∇∂µÅ][A-Za-z0-9_πħωΩΔΣλμσθ∇∂µÅ]*"}
      ]
    }
  }
}
